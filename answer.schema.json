{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungle-scrubs.github.io/model-router/answer.schema.json",
  "title": "model-router answer, contract version 1",
  "description": "The answer shape emitted by model-router contract 1. Routes carry identity, run facts and placement; removed routes carry a coded reason. The answer allows fields this schema does not define; the query schema rejects them on input.",
  "type": "object",
  "properties": {
    "contract": {
      "const": 1
    },
    "routerVersion": {
      "type": "string"
    },
    "registryDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "query": {
      "description": "The query as applied: defaults filled, lists deduplicated. Known fields carry their contract types and vocabularies; fields beyond them are allowed.",
      "type": "object",
      "properties": {
        "profile": { "type": "string" },
        "task": { "type": "string" },
        "minimums": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "needs": { "type": "array", "items": { "type": "string" } },
        "effort": { "type": "string" },
        "pin": { "type": "string" },
        "stakes": { "enum": ["low", "normal", "high"] },
        "prefer": { "enum": ["cost", "speed"] },
        "privacy": { "enum": ["normal", "secret"] },
        "excludeFamilies": { "type": "array", "items": { "type": "string" } },
        "spec": { "enum": ["open", "settled"] }
      },
      "required": ["minimums", "needs", "prefer", "privacy", "spec", "stakes", "excludeFamilies"],
      "additionalProperties": true
    },
    "pin": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "used": { "type": "boolean" },
            "reason": { "type": "string" }
          },
          "required": ["label", "used", "reason"]
        }
      ]
    },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/answerRoute" }
    },
    "removed": {
      "type": "array",
      "items": { "$ref": "#/$defs/removedRoute" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/coded" }
    },
    "availabilityNote": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/coded" }]
    },
    "describe": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "model": { "type": ["string", "null"] },
            "taskGate": { "type": "number", "minimum": 0, "maximum": 1 },
            "capabilityThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "task": {
              "type": "object",
              "properties": {
                "source": { "enum": ["caller", "jev", "inline-need"] },
                "confidence": { "type": ["number", "null"] },
                "candidates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "task": { "type": "string" },
                      "probability": { "type": "number" }
                    },
                    "required": ["task", "probability"]
                  }
                }
              },
              "required": ["source", "confidence", "candidates"]
            },
            "needsAdded": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "capability": { "type": "string" },
                  "probability": { "type": "number" }
                },
                "required": ["capability", "probability"]
              }
            },
            "usage": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "properties": {
                    "input_tokens": { "type": "number" },
                    "output_tokens": { "type": "number" }
                  },
                  "required": ["input_tokens", "output_tokens"]
                }
              ]
            }
          },
          "required": ["model", "taskGate", "capabilityThreshold", "task", "needsAdded", "usage"]
        }
      ]
    }
  },
  "required": [
    "contract",
    "routerVersion",
    "registryDigest",
    "query",
    "pin",
    "routes",
    "removed",
    "warnings",
    "availabilityNote",
    "describe"
  ],
  "$defs": {
    "coded": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "fix": { "type": "string" },
        "field": { "type": "string" }
      },
      "required": ["code", "message"]
    },
    "answerRoute": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "model": { "type": "string" },
        "harness": { "type": "string" },
        "modelId": { "type": "string" },
        "provider": { "type": "string" },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
        "hosted": { "type": "boolean" },
        "family": { "type": "string" },
        "meter": { "type": "string" },
        "placedBy": { "enum": ["pin", "policy", "rank"] },
        "policy": { "type": "string" },
        "floor": { "enum": ["clears", "below", "skipped"] },
        "availability": {
          "enum": ["ok", "projected", "exhausted", "unknown", "unmetered"]
        },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/coded" }
        }
      },
      "required": [
        "label",
        "model",
        "harness",
        "modelId",
        "hosted",
        "family",
        "placedBy",
        "floor",
        "availability",
        "reasons"
      ],
      "allOf": [
        {
          "description": "A policy-placed route names its policy; any other placement omits the field.",
          "if": {
            "properties": { "placedBy": { "const": "policy" } },
            "required": ["placedBy"]
          },
          "then": { "required": ["policy"] },
          "else": { "not": { "required": ["policy"] } }
        }
      ]
    },
    "removedRoute": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "reason": { "$ref": "#/$defs/coded" }
      },
      "required": ["label", "reason"]
    }
  }
}

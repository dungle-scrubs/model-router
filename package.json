{
  "name": "@dungle-scrubs/model-router",
  "version": "0.0.0",
  "description": "Rank model routes for a structured query against a versioned model registry.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle-scrubs/model-router.git"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "model-router": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./query.schema.json": "./query.schema.json",
    "./answer.schema.json": "./answer.schema.json",
    "./availability.schema.json": "./availability.schema.json",
    "./error.schema.json": "./error.schema.json",
    "./config.schema.json": "./config.schema.json",
    "./router-sections.schema.json": "./router-sections.schema.json"
  },
  "files": [
    "dist",
    "availability.schema.json",
    "query.schema.json",
    "answer.schema.json",
    "error.schema.json",
    "config.schema.json",
    "router-sections.schema.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "hooks:install": "lefthook install",
    "prepack": "pnpm verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.18.6",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "lefthook": "2.1.15",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "@dungle-scrubs/model-registry": "github:dungle-scrubs/model-registry#fc801cd27288c6bf873c39ef7834cbed82599046",
    "commander": "15.0.0"
  }
}
